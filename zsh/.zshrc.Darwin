# macOS-specific runtime configuration
# This file is sourced at shell startup and should be fast and non-interactive
# All package installation and setup is handled by 'dotfiles bootstrap'

# Additional macOS-specific aliases
alias ss="sudo -Es"

# Environment variables
export DOTNET_ROOT="/usr/local/share/dotnet"
export GOPATH="${HOME}/go"
if command -v brew >/dev/null 2>&1; then
  export GOROOT="$(brew --prefix golang 2>/dev/null)/libexec" || true
fi

# PATH additions (macOS-specific)
if [[ -d "/opt/homebrew/opt/python@3.13/bin" ]]; then
  path=(
    "/opt/homebrew/opt/python@3.13/bin"
    $path
  )
fi

# Additional Oh-My-Zsh plugins for macOS
ZSH_PLUGINS+=(
  brew
  cask
  macos
  taskwarrior
  tmuxinator
)

# Powerlevel10k right prompt elements
POWERLEVEL9K_RIGHT_PROMPT_ELEMENTS=(root_indicator ssh background_jobs history)
