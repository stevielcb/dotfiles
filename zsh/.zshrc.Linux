# Linux-specific runtime configuration
# This file is sourced at shell startup and should be fast and non-interactive
# All package installation and setup is handled by 'dotfiles bootstrap'

# Additional Linux-specific aliases
alias ss="sudo --preserve-env=HOME -s"

# LinuxBrew PATH (if installed)
if [[ -d "/home/linuxbrew/.linuxbrew/bin" ]]; then
  path=(
    "/home/linuxbrew/.linuxbrew/bin"
    $path
  )
fi

# Additional PATH for local vim builds
if [[ -d "${HOME}/.local/vim/bin" ]]; then
  path=(
    "${HOME}/.local/vim/bin"
    $path
  )
fi

# Additional Oh-My-Zsh plugins for Linux
ZSH_PLUGINS+=(
  brew
  cask
  systemd
)

# Detect Linux distribution and add distro-specific plugins
if [[ -f /etc/os-release ]]; then
  local os_id
  os_id=$(grep -i "^ID=" /etc/os-release 2>/dev/null | cut -d= -f2 | tr -d '"' | tr '[:upper:]' '[:lower:]')
  
  case "${os_id}" in
    ubuntu)
      ZSH_PLUGINS+=(ubuntu ufw)
      ;;
    fedora)
      ZSH_PLUGINS+=(dnf)
      ;;
    centos|rhel)
      ZSH_PLUGINS+=(yum)
      ;;
    arch|manjaro)
      ZSH_PLUGINS+=(archlinux)
      ;;
  esac
fi

# Powerlevel10k right prompt elements
POWERLEVEL9K_RIGHT_PROMPT_ELEMENTS=(root_indicator ssh background_jobs history)
